# Do not commit a populated .env file.
APP_ENV=development
LOG_LEVEL=INFO
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_API_KEY=
# Optional policy override example: WEB_RESEARCH__PAGE_TIMEOUT_SECONDS=15
# Optional runtime override example: MODEL_RUNTIME__MODEL_CACHE_DIRECTORY=.local/model_cache
# Default role-based Gemini route. Override for a deployment with different
# model availability, quality, cost, or quota requirements.
GEMINI__CLIENT_MODEL=gemini-3.5-flash-lite
GEMINI__ADVISOR_MODEL=gemini-3.5-flash
GEMINI__ANALYST_MODEL=gemini-3.5-flash
GEMINI__FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional output-budget overrides: GEMINI__ADVISOR_MAX_OUTPUT_TOKENS=3000
# Optional output-budget overrides: GEMINI__ANALYST_MAX_OUTPUT_TOKENS=4096
# Optional timeout override examples:
# GEMINI__CLIENT_TURN_TIMEOUT_SECONDS=150
# GEMINI__ADVISOR_TURN_TIMEOUT_SECONDS=200
# GEMINI__ANALYST_TASK_TIMEOUT_SECONDS=250
# Optional storage override example: STORAGE__LANCEDB_DATABASE_PATH=data/lancedb
# Optional endpoint override example: PROVIDER_ENDPOINTS__EXA_BASE_URL=https://api.exa.ai
